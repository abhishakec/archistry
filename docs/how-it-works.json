      { "id": "img", "label": "PNG · JPG · SVG", "sub": "for Word, Confluence, slides", "icon": "doctype/image" }
    ] }
  ],
  "links": [
    { "from": "ask", "to": "pick", "step": 1 },
    { "from": "meta", "to": "spec", "label": "generators", "style": "async" },
    { "from": "pick", "to": "spec", "step": 2 },
    { "from": "spec", "to": "layout", "label": "archistry build", "step": 3 },
    { "from": "layout", "to": "notate" },
