        },
        {
          "id": "keys",
          "label": "Key cross-reference",
          "sub": "Legacy Id to External Id",
          "icon": "utility/key"
        }
      ]
    },
    {
      "zone": "Salesforce",
      "kind": "salesforce",
      "children": [
        {
          "id": "load",
          "label": "Load",
          "sub": "Bulk API 2.0 · parents first",
          "icon": "utility/database"
        },
        {
          "id": "org",
          "label": "Production org",
          "sub": "Account, Contact, Case",
          "icon": "product/sales_cloud"
        },
        {
          "id": "recon",
          "label": "Reconcile",
          "sub": "Counts, checksums, sample audit",
          "icon": "standard/report",
          "kind": "success"
        }
      ]
    }
  ],
  "links": [
    {
      "from": "legacy",
      "to": "extract",
      "label": "Nightly",
      "style": "batch",
      "step": 1
    },
    {
      "from": "sheets",
      "to": "extract",
      "label": "Manual upload",
      "style": "manual"
    },
    { "from": "extract", "to": "stage", "step": 2 },
    { "from": "stage", "to": "cleanse", "step": 3 },
    { "from": "cleanse", "to": "map", "step": 4 },
    { "from": "map", "to": "keys" },
    { "from": "map", "to": "load", "label": "CSV batches", "step": 5 },
    { "from": "load", "to": "org", "step": 6 },
    { "from": "org", "to": "recon", "step": 7 },
    {
      "from": "recon",
      "to": "stage",
      "label": "Rejects for rework",
      "style": "reference"
