{
  "type": "data-flow",
  "title": "Legacy CRM Migration — Data Flow",
  "subtitle": "Extract, cleanse, transform and load customer data into Salesforce, with reconciliation",
  "layout": "row",
  "children": [
    {
      "zone": "Sources",
      "kind": "external",
      "children": [
        {
          "id": "legacy",
          "label": "Legacy CRM",
          "sub": "SQL Server · 2.1M accounts",
          "icon": "utility/database"
        },
        {
          "id": "sheets",
          "label": "Regional spreadsheets",
          "sub": "Contacts, preferences",
          "icon": "doctype/excel"
        }
      ]
    },
    {
      "zone": "Staging",
      "kind": "integration",
      "children": [
        {
          "id": "extract",
          "label": "Extract",
          "sub": "Full + delta extracts",
          "icon": "utility/sync"
        },
        {
          "id": "stage",
          "label": "Staging database",
          "sub": "Raw landing tables",
          "icon": "utility/database"
        }
      ]
    },
    {
      "zone": "Transform",
      "kind": "data",
      "children": [
        {
          "id": "cleanse",
          "label": "Cleanse & dedupe",
          "sub": "Address standardisation, match rules",
          "icon": "utility/settings"
        },
        {
          "id": "map",
          "label": "Map & transform",
          "sub": "Field mapping, picklist translation",
