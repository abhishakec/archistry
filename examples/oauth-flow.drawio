        <mxCell id="m_1" value="&lt;b&gt;1.&lt;/b&gt; Click &quot;Log in with Salesforce&quot;" style="html=1;rounded=0;strokeColor=#514f4d;strokeWidth=1.5;fontSize=11;fontColor=#032d60;endArrow=block;endFill=1;endSize=6;edgeStyle=none;verticalAlign=bottom;exitX=0.5;exitY=0.1283;exitDx=0;exitDy=0;entryX=0.5;entryY=0.1283;entryDx=-5;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="user" target="app"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-10.6" as="offset"/></mxGeometry></mxCell>
