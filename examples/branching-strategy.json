    { "id": "d1", "kind": "state", "label": "Merge (PR)", "sub": "Deploys to SIT", "lane": "develop", "color": "integration" },
    { "id": "r1", "kind": "state", "label": "release/2027.03", "sub": "Deploys to UAT", "lane": "release", "color": "warning" },
