        <mxCell id="panel" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#5c5c5c&quot;&gt;TOPIC · JOB TO BE DONE&lt;/font&gt;&lt;br&gt;&lt;b&gt;&lt;font style=&quot;font-size:15px&quot;&gt;Order Status &amp;amp; Delivery&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5c5c5c&quot;&gt;&lt;b&gt;Classification description&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#032d60&quot;&gt;Customer asks where an order is, when it will arrive, or wants to change a delivery slot.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5c5c5c&quot;&gt;&lt;b&gt;Scope&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#032d60&quot;&gt;Look up orders owned by the verified customer, share status and ETA, rebook delivery. Not in scope: refunds, returns, pricing.&lt;/font&gt;" style="html=1;whiteSpace=wrap;rounded=1;arcSize=16;absoluteArcSize=1;fillColor=#eef1ff;strokeColor=#3a49da;strokeWidth=1.5;fontColor=#032d60;fontSize=12;align=left;verticalAlign=top;spacingLeft=48;spacingTop=8;spacingRight=10;container=1;collapsible=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="40" y="110" width="440" height="120" as="geometry"/></mxCell>
        <mxCell id="ico_8" value="" style="html=1;shape=image;aspect=fixed;imageAspect=1;image=data:image/svg+xml,;part=1;pointerEvents=0;" vertex="1" connectable="0" parent="panel"><mxGeometry x="12" y="12" width="26" height="26" as="geometry"/></mxCell>
        <mxCell id="panel_2" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#5c5c5c&quot;&gt;GUARDRAILS · ALWAYS / NEVER&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#032d60&quot;&gt;• Always verify the customer's identity before sharing order details&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#032d60&quot;&gt;• Never promise a delivery date that the carrier has not confirmed&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#032d60&quot;&gt;• Never discuss another customer's order&lt;/font&gt;" style="html=1;whiteSpace=wrap;rounded=1;arcSize=16;absoluteArcSize=1;fillColor=#fdf0f7;strokeColor=#b60554;strokeWidth=1.5;fontColor=#032d60;fontSize=12;align=left;verticalAlign=top;spacingLeft=48;spacingTop=8;spacingRight=10;container=1;collapsible=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="510" y="110" width="380" height="120" as="geometry"/></mxCell>
        <mxCell id="ico_9" value="" style="html=1;shape=image;aspect=fixed;imageAspect=1;image=data:image/svg+xml,;part=1;pointerEvents=0;" vertex="1" connectable="0" parent="panel_2"><mxGeometry x="12" y="12" width="26" height="26" as="geometry"/></mxCell>
        <mxCell id="panel_3" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#5c5c5c&quot;&gt;CONTEXT&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5c5c5c&quot;&gt;&lt;b&gt;Variables / inputs&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#032d60&quot;&gt;Verified Contact Id · Order number · Messaging channel&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5c5c5c&quot;&gt;&lt;b&gt;Grounding data&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#032d60&quot;&gt;Order &amp;amp; OrderItem · Shipment (carrier API) · Knowledge: delivery policy&lt;/font&gt;" style="html=1;whiteSpace=wrap;rounded=1;arcSize=16;absoluteArcSize=1;fillColor=#f6f2fb;strokeColor=#5a1ba9;strokeWidth=1.5;fontColor=#032d60;fontSize=12;align=left;verticalAlign=top;spacingLeft=48;spacingTop=8;spacingRight=10;container=1;collapsible=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="920" y="110" width="300" height="120" as="geometry"/></mxCell>
