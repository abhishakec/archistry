        <mxCell id="card_16" value="&lt;b&gt;Manual sharing&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5c5c5c&quot;&gt;Owner shares one record&lt;/font&gt;" style="html=1;whiteSpace=wrap;rounded=1;arcSize=16;absoluteArcSize=1;fillColor=#ffffff;strokeColor=#2e844a;strokeWidth=1.5;fontColor=#032d60;fontSize=13;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="zone_4_Teams_and_manual_sharing"><mxGeometry x="300" y="76" width="200" height="60" as="geometry"/></mxCell>
        <mxCell id="card_17" value="&lt;b&gt;Apex managed sharing&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5c5c5c&quot;&gt;Programmatic share rows&lt;/font&gt;" style="html=1;whiteSpace=wrap;rounded=1;arcSize=16;absoluteArcSize=1;fillColor=#ffffff;strokeColor=#2e844a;strokeWidth=1.5;fontColor=#032d60;fontSize=13;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="zone_4_Teams_and_manual_sharing"><mxGeometry x="510" y="76" width="200" height="60" as="geometry"/></mxCell>
        <mxCell id="t" value="&lt;b&gt;&lt;font style=&quot;font-size:20px&quot;&gt;Record Access — Sharing Model&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#5c5c5c&quot;&gt;Access starts at the most restrictive baseline and is opened layer by layer; object permissions always apply first&lt;/font&gt;" style="html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontColor=#032d60;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="36" width="800" height="62" as="geometry"/></mxCell>
