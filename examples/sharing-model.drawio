        <mxCell id="zone_4_Teams_and_manual_sharing" value="&lt;b&gt;4 · Teams and manual sharing&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5c5c5c&quot;&gt;Record-by-record exceptions&lt;/font&gt;" style="html=1;whiteSpace=wrap;rounded=1;arcSize=20;absoluteArcSize=1;fillColor=#ebf7e6;strokeColor=#2e844a;strokeWidth=1.5;fontColor=#032d60;fontSize=13;align=left;verticalAlign=top;spacingLeft=14;spacingTop=9;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="40" y="870" width="800" height="160" as="geometry"/></mxCell>
