        <mxCell id="card_9" value="&lt;b&gt;Knowledge&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5c5c5c&quot;&gt;Public Read Only&lt;/font&gt;" style="html=1;whiteSpace=wrap;rounded=1;arcSize=16;absoluteArcSize=1;fillColor=#ffffff;strokeColor=#ba0517;strokeWidth=1.5;fontColor=#032d60;fontSize=13;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="zone_1_Organization_wide_defaults"><mxGeometry x="630" y="76" width="140" height="60" as="geometry"/></mxCell>
        <mxCell id="zone_2_Role_hierarchy" value="&lt;b&gt;2 · Role hierarchy&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5c5c5c&quot;&gt;Managers inherit access to records owned by their subordinates&lt;/font&gt;" style="html=1;whiteSpace=wrap;rounded=1;arcSize=20;absoluteArcSize=1;fillColor=#fbf3e0;strokeColor=#ca8501;strokeWidth=1.5;fontColor=#032d60;fontSize=13;align=left;verticalAlign=top;spacingLeft=14;spacingTop=9;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="40" y="490" width="800" height="160" as="geometry"/></mxCell>
        <mxCell id="card_10" value="&lt;b&gt;Grant access using hierarchies&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5c5c5c&quot;&gt;On for standard objects&lt;/font&gt;" style="html=1;whiteSpace=wrap;rounded=1;arcSize=16;absoluteArcSize=1;fillColor=#ffffff;strokeColor=#ca8501;strokeWidth=1.5;fontColor=#032d60;fontSize=13;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="zone_2_Role_hierarchy"><mxGeometry x="200" y="76" width="200" height="60" as="geometry"/></mxCell>
        <mxCell id="card_11" value="&lt;b&gt;Territory hierarchy&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5c5c5c&quot;&gt;Account access by territory&lt;/font&gt;" style="html=1;whiteSpace=wrap;rounded=1;arcSize=16;absoluteArcSize=1;fillColor=#ffffff;strokeColor=#ca8501;strokeWidth=1.5;fontColor=#032d60;fontSize=13;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="zone_2_Role_hierarchy"><mxGeometry x="410" y="76" width="200" height="60" as="geometry"/></mxCell>
        <mxCell id="zone_3_Sharing_rules" value="&lt;b&gt;3 · Sharing rules&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5c5c5c&quot;&gt;Automatic exceptions for groups of users&lt;/font&gt;" style="html=1;whiteSpace=wrap;rounded=1;arcSize=20;absoluteArcSize=1;fillColor=#eaf5fe;strokeColor=#0176d3;strokeWidth=1.5;fontColor=#032d60;fontSize=13;align=left;verticalAlign=top;spacingLeft=14;spacingTop=9;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="40" y="680" width="800" height="160" as="geometry"/></mxCell>
        <mxCell id="card_12" value="&lt;b&gt;Owner-based rules&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5c5c5c&quot;&gt;Share EMEA accounts with EMEA Service&lt;/font&gt;" style="html=1;whiteSpace=wrap;rounded=1;arcSize=16;absoluteArcSize=1;fillColor=#ffffff;strokeColor=#0176d3;strokeWidth=1.5;fontColor=#032d60;fontSize=13;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="zone_3_Sharing_rules"><mxGeometry x="90" y="76" width="200" height="60" as="geometry"/></mxCell>
        <mxCell id="card_13" value="&lt;b&gt;Criteria-based rules&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5c5c5c&quot;&gt;Share cases where Type = Escalation&lt;/font&gt;" style="html=1;whiteSpace=wrap;rounded=1;arcSize=16;absoluteArcSize=1;fillColor=#ffffff;strokeColor=#0176d3;strokeWidth=1.5;fontColor=#032d60;fontSize=13;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="zone_3_Sharing_rules"><mxGeometry x="300" y="76" width="200" height="60" as="geometry"/></mxCell>
