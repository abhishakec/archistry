<mxfile host="app.diagrams.net" agent="archistry" type="device">
  <diagram id="page" name="Record Access — Sharing Model">
    <mxGraphModel dx="880" dy="1070" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="880" pageHeight="1070" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="zone_0_Object_and_field_access" value="&lt;b&gt;0 · Object and field access&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5c5c5c&quot;&gt;Profiles and permission sets decide which objects and fields a user can touch at all&lt;/font&gt;" style="html=1;whiteSpace=wrap;rounded=1;arcSize=20;absoluteArcSize=1;fillColor=#fdf0f7;strokeColor=#b60554;strokeWidth=1.5;fontColor=#032d60;fontSize=13;align=left;verticalAlign=top;spacingLeft=14;spacingTop=9;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="800" height="160" as="geometry"/></mxCell>
        <mxCell id="card" value="&lt;b&gt;Profiles&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5c5c5c&quot;&gt;Minimum access baseline&lt;/font&gt;" style="html=1;whiteSpace=wrap;rounded=1;arcSize=16;absoluteArcSize=1;fillColor=#ffffff;strokeColor=#b60554;strokeWidth=1.5;fontColor=#032d60;fontSize=13;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="zone_0_Object_and_field_access"><mxGeometry x="30" y="76" width="180" height="60" as="geometry"/></mxCell>
        <mxCell id="card_2" value="&lt;b&gt;Permission Sets&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5c5c5c&quot;&gt;Additive, task-based&lt;/font&gt;" style="html=1;whiteSpace=wrap;rounded=1;arcSize=16;absoluteArcSize=1;fillColor=#ffffff;strokeColor=#b60554;strokeWidth=1.5;fontColor=#032d60;fontSize=13;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="zone_0_Object_and_field_access"><mxGeometry x="220" y="76" width="180" height="60" as="geometry"/></mxCell>
        <mxCell id="card_3" value="&lt;b&gt;Permission Set Groups&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5c5c5c&quot;&gt;Persona bundles + muting&lt;/font&gt;" style="html=1;whiteSpace=wrap;rounded=1;arcSize=16;absoluteArcSize=1;fillColor=#ffffff;strokeColor=#b60554;strokeWidth=1.5;fontColor=#032d60;fontSize=13;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="zone_0_Object_and_field_access"><mxGeometry x="410" y="76" width="180" height="60" as="geometry"/></mxCell>
        <mxCell id="card_4" value="&lt;b&gt;Field-Level Security&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5c5c5c&quot;&gt;Read / edit per field&lt;/font&gt;" style="html=1;whiteSpace=wrap;rounded=1;arcSize=16;absoluteArcSize=1;fillColor=#ffffff;strokeColor=#b60554;strokeWidth=1.5;fontColor=#032d60;fontSize=13;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="zone_0_Object_and_field_access"><mxGeometry x="600" y="76" width="180" height="60" as="geometry"/></mxCell>
        <mxCell id="zone_1_Organization_wide_defaults" value="&lt;b&gt;1 · Organization-wide defaults&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5c5c5c&quot;&gt;The baseline for records a user does not own&lt;/font&gt;" style="html=1;whiteSpace=wrap;rounded=1;arcSize=20;absoluteArcSize=1;fillColor=#fef1ee;strokeColor=#ba0517;strokeWidth=1.5;fontColor=#032d60;fontSize=13;align=left;verticalAlign=top;spacingLeft=14;spacingTop=9;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="800" height="160" as="geometry"/></mxCell>
