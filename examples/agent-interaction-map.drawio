        <mxCell id="agent" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#5c5c5c&quot;&gt;AGENTFORCE SERVICE AGENT&lt;/font&gt;&lt;br&gt;&lt;b&gt;&lt;font style=&quot;font-size:16px&quot;&gt;Retail Service Agent&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#032d60&quot;&gt;Answers order, delivery and returns questions for signed-in customers, 24/7.&lt;/font&gt;" style="html=1;whiteSpace=wrap;rounded=1;arcSize=20;absoluteArcSize=1;fillColor=#eef1ff;strokeColor=#3a49da;strokeWidth=2;fontColor=#032d60;fontSize=12;align=left;verticalAlign=top;spacingLeft=66;spacingTop=12;spacingRight=12;container=1;collapsible=0;recursiveResize=0;shadow=1;" vertex="1" parent="1"><mxGeometry x="430" y="270" width="320" height="420" as="geometry"/></mxCell>
