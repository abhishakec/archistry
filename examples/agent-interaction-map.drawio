        <mxCell id="agent_sec_2" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#5c5c5c&quot;&gt;&lt;b&gt;GLOBAL INSTRUCTIONS&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#032d60&quot;&gt;• Be concise, friendly and never guess&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#032d60&quot;&gt;• Confirm identity before any order data&lt;/font&gt;" style="html=1;whiteSpace=wrap;rounded=1;arcSize=12;absoluteArcSize=1;fillColor=#ffffff;strokeColor=#969492;strokeWidth=1;fontColor=#032d60;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;part=1;" vertex="1" connectable="0" parent="agent"><mxGeometry x="14" y="190" width="292" height="60" as="geometry"/></mxCell>
